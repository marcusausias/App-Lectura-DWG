<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No se piden permisos de almacenamiento a propósito. El acceso a los
      planos va por el Storage Access Framework: el usuario concede la carpeta
      del proyecto una sola vez y ese permiso se conserva entre sesiones, que
      es el mecanismo con el que la app recuerda dónde están las referencias
      externas.
    -->

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppLecturaDWG">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.AppLecturaDWG">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
